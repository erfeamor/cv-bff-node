PORT=3000
DOMAIN_SERVICE_URL=http://localhost:8080

# Comma-separated browser origins allowed to call the BFF. Local dev default
# below is the cv-public-vanilla preview server. Deployed environments must set
# the real public-site origin (the CloudFront distribution domain, or the custom
# domain in front of it) — never hardcode a distribution domain in source:
#   CORS_ALLOWED_ORIGINS=https://d111111abcdef8.cloudfront.net
#   CORS_ALLOWED_ORIGINS=https://d111111abcdef8.cloudfront.net,http://localhost:4173
CORS_ALLOWED_ORIGINS=http://localhost:4173

# Set AUTH_ENABLED=true in deployed environments; requires a real user pool.
AUTH_ENABLED=false
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_ME_USER_POOL_ID
